<script>
	import Statement from '$lib/components/Statement.svelte';
	import Proof from '$lib/components/Proof.svelte';
	import * as linearization from './statements/linearization.md';
	import * as gaussNewton from './statements/gauss-newton.md';
	import * as exact from './statements/exact.md';
