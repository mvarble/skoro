{
    "name": "skoro-site",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "format": "prettier --write .",
        "lint": "prettier --check . && eslint .",
        "todos": "grep -rn '\\[!TODO\\]' src/content",
        "test": "vitest run"
    },
    "engines": {
        "pnpm": "^10.10.0"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild"
        ]
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@sveltejs/adapter-static": "^3.0.10",
        "@sveltejs/kit": "^2.63.0",
        "@sveltejs/vite-plugin-svelte": "^7.1.2",
        "@types/hast": "2.3.1",
        "@types/katex": "^0.16.7",
        "@types/mdast": "^3.0.15",
        "@types/node": "^24.0.0",
        "eslint": "^10.4.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.19.0",
        "github-slugger": "^2.0.0",
        "globals": "^17.6.0",
        "katex": "^0.18.4",
        "mdsvex": "^0.12.7",
        "prettier": "^3.9.6",
        "prettier-plugin-svelte": "^4.1.0",
        "remark-math": "3.0.0",
        "shiki": "^4.4.3",
        "svelte": "^5.56.1",
        "svelte-check": "^4.6.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.60.1",
        "unified": "^11.0.5",
        "vfile": "^6.0.3",
        "vite": "^8.0.16",
        "vitest": "^5.0.1"
    },
    "dependencies": {
        "@fontsource-variable/inter": "^5.2.5",
        "@fontsource/jetbrains-mono": "^5.2.5"
    }
}
